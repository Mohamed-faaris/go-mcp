# Model provider (OpenAI-compatible API)
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_API_KEY=replace_with_your_secret
OPENAI_MODEL=your_tool_calling_model

# MCP configuration
MCP_CONFIG_PATH=config/mcp_servers.json

# Agent execution
MAX_STEPS=12
MAX_TOOL_CALLS=24
REQUEST_TIMEOUT_SECONDS=90

# Security
# Approval modes: all | dangerous | none
APPROVAL_MODE=all
ALLOW_SHELL=true

# Logging
# Log levels: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
